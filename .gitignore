# ====================================
# 1. Output biên dịch (Prerequisites & Objects)
# ====================================
*.o
*.obj
*.d
*.i
*.s

# ====================================
# 2. Thư viện liên kết (Static & Dynamic Libraries)
# ====================================
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# ====================================
# 3. File thực thi (Executables)
# ====================================
*.exe
*.out
*.app
*.bin

# ====================================
# 4. Debug & Crash Logs
# ====================================
*.pdb
*.ilk
*.idb
*.dSYM/
*.suo
*.core
*.log

# ====================================
# 5. Hệ thống Build (CMake, Meson, Make)
# ====================================
# Thư mục build thông thường (CMake / Meson)
build/
build-*/
bin/
out/

# CMake cache nếu lỡ chạy in-source build (cmake .)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
!Makefile
!Makefile.am
!Makefile.in

# ====================================
# 6. Cấu hình IDE / Text Editor
# ====================================
# Visual Studio
.vs/
*.sln.docstates
*.user

# VS Code (giữ lại tasks.json/launch.json nếu muốn share cấu hình team)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
.cache/
compile_commands.json

# CLion (JetBrains)
.idea/
cmake-build-*/

# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# ====================================
# 7. File rác hệ điều hành
# ====================================
.DS_Store
Thumbs.db
# ====================================
# 8. Data
# ====================================
data/


