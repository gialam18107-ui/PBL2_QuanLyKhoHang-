{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Active C++ File",
      "command": "mingw32-make",
      "args": [
        "${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "type": "shell",
      "label": "Build Selected C++ File",
      "command": "mingw32-make",
      "args": [
        "${input:targetExecutableName}.exe"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "type": "shell",
      "label": "Build main.cpp (app.exe)",
      "command": "mingw32-make",
      "args": [
        "app.exe"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "type": "shell",
      "label": "Build guiding.cpp",
      "command": "mingw32-make",
      "args": [
        "guiding.exe"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "type": "shell",
      "label": "Build test_io.cpp (test_io.exe)",
      "command": "mingw32-make",
      "args": [
        "test_io.exe"
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "type": "shell",
      "label": "Clean Project",
      "command": "mingw32-make",
      "args": [
        "clean"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "targetCppFile",
      "type": "pickString",
      "description": "Select the main .cpp file to build:",
      "options": [
        "main.cpp",
        "guiding.cpp",
        "test_io.cpp"
      ],
      "default": "test_io.cpp"
    },
    {
      "id": "targetExecutableName",
      "type": "promptString",
      "description": "Enter the output executable name (without .exe):",
      "default": "app"
    }
  ]
}